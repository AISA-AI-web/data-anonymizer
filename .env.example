# Copy to .env.local (never committed) to try this locally.
# Links to policy documents that only signed-in staff can open, e.g. a restricted Google Drive file.
# The link text and URL are visible to anyone who opens the app, so use a neutral title
# and make sure the document itself is access-controlled.
VITE_POLICY_LINKS=[{"title":"School AI & data policy (staff only)","url":"https://drive.google.com/file/d/REPLACE_ME/view","note":"Sign in with your school account"}]
