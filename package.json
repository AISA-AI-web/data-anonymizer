{
  "name": "data-anonymizer",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-only tool that pseudonymizes student spreadsheets before AI analysis and re-identifies the AI results afterwards.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.2.8",
    "exceljs": "4.4.0",
    "papaparse": "5.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
